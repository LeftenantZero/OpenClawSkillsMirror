{
  "changelog": "corruption-burner v1.0.0 \u2014 \u0623\u0648\u0644 \u0625\u0635\u062f\u0627\u0631\n\n- \u0625\u0637\u0644\u0627\u0642 \u0646\u0638\u0627\u0645 \u0634\u0627\u0645\u0644 \u0644\u0645\u062d\u0627\u0631\u0628\u0629 \u0627\u0644\u0641\u0633\u0627\u062f \u062c\u0630\u0631\u064a\u0627\u064b \u0645\u0633\u062a\u0645\u062f\u0627\u064b \u0645\u0646 \u0627\u0644\u0642\u0631\u0622\u0646 \u0648\u0627\u0644\u0633\u0646\u0629 \u0627\u0644\u0635\u062d\u064a\u062d\u0629\u060c \u0645\u0639 \u062a\u0635\u0646\u064a\u0641 9 \u0623\u0633\u0628\u0627\u0628 \u062c\u0630\u0631\u064a\u0629 \u0631\u0626\u064a\u0633\u064a\u0629 \u0644\u0644\u0641\u0633\u0627\u062f.\n- \u062a\u0642\u062f\u064a\u0645 \u0646\u0645\u0648\u0630\u062c \"\u0641\u0631\u0639\u0648\u0646 \u0648\u0645\u0644\u0625\u0647\" \u0644\u062a\u062d\u0644\u064a\u0644 \u0627\u0644\u0635\u0631\u0627\u0639 \u0627\u0644\u0645\u0639\u0627\u0635\u0631 \u0648\u062a\u062d\u062f\u064a\u062f \u0623\u062f\u0648\u0627\u0631 \u0627\u0644\u0637\u063a\u064a\u0627\u0646 \u0648\u0627\u0644\u062a\u062d\u0627\u0644\u0641\u0627\u062a.\n- \u062a\u0635\u0645\u064a\u0645 14 \u0645\u0647\u0645\u0629 \u062a\u0639\u0644\u064a\u0645\u064a\u0629 \u0645\u062c\u062f\u0648\u0644\u0629 \u062a\u0644\u0642\u0627\u0626\u064a\u0627\u064b \u0628\u0646\u0638\u0627\u0645 \u0643\u0631\u0648\u0646 \u0645\u0639 \u062e\u0637\u0629 \u0646\u0634\u0631 \u0639\u0628\u0631 \u0645\u0646\u0635\u0627\u062a \u0645\u062e\u062a\u0644\u0641\u0629.\n- \u062a\u0636\u0645\u064a\u0646 \u0647\u064a\u0643\u0644 \u0648\u0627\u0636\u062d \u0644\u0643\u0644 \u0645\u0647\u0645\u0629 (\u062a\u0634\u062e\u064a\u0635\u060c \u0633\u0628\u0628\u060c \u062e\u0637\u0629 \u0639\u0645\u0644\u064a\u0629\u060c \u062a\u0639\u0644\u064a\u0645 \u0627\u0644\u0648\u0643\u0644\u0627\u0621\u060c \u062e\u062a\u0645).\n- \u062a\u0637\u0628\u064a\u0642 \u0642\u0648\u0627\u0639\u062f \u0645\u062d\u062a\u0648\u0649 \u0635\u0627\u0631\u0645\u0629 \u062a\u0631\u0643\u0632 \u0639\u0644\u0649 \u0627\u0644\u062f\u0642\u0629 \u0648\u0627\u0644\u0645\u0635\u0627\u062f\u0631 \u0648\u0627\u0644\u0630\u0643\u0631 \u0627\u0644\u062f\u064a\u0646\u064a \u0641\u064a \u0627\u0644\u062e\u062a\u0627\u0645.",
