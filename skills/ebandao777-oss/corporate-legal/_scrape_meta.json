{
  "changelog": "\u4f01\u4e1a\u6cd5\u52a1\u6280\u80fd\u5957\u4ef6\u521d\u7248\u53d1\u5e03\uff0c\u63d0\u4f9b\u5168\u6d41\u7a0b\u3001\u591a\u5b50\u6280\u80fd\u3001\u4e00\u4f53\u5316\u6cd5\u52a1\u667a\u80fd\u670d\u52a1\uff1a\n\n- \u8986\u76d6\u4f01\u4e1a\u80cc\u666f\u8c03\u67e5\u3001\u516c\u53f8\u51b3\u8bae\u3001\u5408\u89c4\u5ba1\u67e5\u3001\u6848\u4f8b\u68c0\u7d22\u3001\u6cd5\u52a1\u65e5\u62a5\u3001\u6cd5\u5f8b\u6587\u4e66\u3001\u7535\u5b50\u7b7e\u53d1\u8d77\u3001\u98ce\u9669\u8bc4\u4f308\u5927\u6838\u5fc3\u6cd5\u52a1\u5b50\u6280\u80fd\u3002\n- \u5f15\u5165\u300c\u610f\u56fe\u8bc6\u522b-\u8def\u7531-\u6a21\u677f\u6267\u884c\u300d\u6d41\u7a0b\uff0c\u6240\u6709\u5b50\u6280\u80fd\u64cd\u4f5c\u4e25\u683c\u6309\u6a21\u677f\u89c4\u8303\u4ea4\u4ed8\uff0c\u652f\u6301\u591a\u573a\u666f\u81ea\u52a8\u5339\u914d\u3002\n- \u5f3a\u5236\u4f9d\u8d56\u6cd5\u5f8b\u6761\u6587\u6eaf\u6e90/\u98ce\u9669\u77e9\u9635/\u5de5\u5546\u6570\u636e\u6574\u5408\u7b49\u7279\u8272\u6807\u51c6\uff0c\u5b9e\u73b0\u5b9a\u91cf\u3001\u7ed3\u6784\u5316\u4e0e\u5408\u89c4\u8f93\u51fa\u3002\n- \u5bf9\u63a5\u516d\u6b65\u95ed\u73af\u5de5\u4f5c\u6d41\uff0c\u5b9e\u73b0\u4efb\u52a1\u5168\u73af\u8282\u53ef\u63a7\u3001\u53ef\u8ffd\u6eaf\uff0c\u6dfb\u52a0\u89d2\u8272\u5206\u5de5\u3001\u8f6e\u6b21\u6536\u655b\u4e0e\u72ec\u7acb\u9a8c\u6536\u673a\u5236\u3002\n- \u5185\u7f6e\u534f\u540c\u6307\u5f15\uff0c\u652f\u6301\u4e0e\u5408\u540c\u3001\u8d22\u7a0e\u3001\u6295\u884c\u3001\u80a1\u6743\u6295\u8d44\u7b49\u5916\u90e8\u6280\u80fd\u96c6\u6210\u3002\n- \u4e3a\u6cd5\u5f8b\u56e2\u961f\u4e0e\u4f01\u4e1a\u7528\u6237\u6784\u5efa\u6db5\u76d6\u5c3d\u8c03\u3001",
