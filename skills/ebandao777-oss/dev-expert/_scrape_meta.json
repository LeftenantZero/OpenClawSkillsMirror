0\u6d4b\u8bd5/\u5b89\u5168\u6d4b\u8bd5/\u6027\u80fd\u6d4b\u8bd5/\u957f\u4efb\u52a1\u6d4b\u8bd5)\uff1b\u6280\u672f\u9009\u578b(\u6280\u672f\u6808/\u6846\u67b6\u9009\u578b)\uff1b\u6587\u6863\u751f\u6210(API\u6587\u6863/README/\u6280\u672f\u6587\u6863/\u90e8\u7f72\u8bf4\u660e/\u56de\u6eda\u8bf4\u660e/\u8fd0\u7ef4\u6587\u6863)\uff1b\u4efb\u52a1\u62c6\u89e3\u4e0e\u6267\u884c(\u4efb\u52a1\u5206\u89e3/Wave\u6267\u884c)\uff1bSpec\u9a71\u52a8\u5f00\u53d1(spec/\u9700\u6c42\u5bf9\u9f50/\u9700\u6c42\u89c4\u683c)\uff1bKarpathy\u7f16\u7801\u89c4\u8303(Karpathy/\u7f16\u7801\u54f2\u5b66/\u7b80\u6d01\u4f18\u5148)\uff1b\u9879\u76ee\u8bb0\u5fc6\u7ba1\u7406(\u9879\u76ee\u8bb0\u5fc6/\u8de8\u4f1a\u8bdd/\u4e0a\u4e0b\u6587\u6c89\u6dc0)\uff1bCMS\u4e8c\u6b21\u5f00\u53d1(CMS/\u5e1d\u56fdCMS/WordPress/ThinkPHP/PHP8\u517c\u5bb9/\u4e8c\u6b21\u5f00\u53d1/\u63d2\u4ef6\u5f00\u53d1/\u6a21\u677f\u5f00\u53d1/\u6279\u91cf\u4efb\u52a1/\u5bfc\u5165\u5bfc\u51fa/\u751f\u6210\u9759\u6001\u9875)\uff1b\u524d\u7aef\u8bbe\u8ba1(UI\u8bbe\u8ba1/UX/\u4ea4\u4e92\u8bbe\u8ba1/\u54cd\u5e94\u5f0f/\u8bbe\u8ba1\u7cfb\u7edf/\u53ef\u8bbf\u95ee\u6027/\u9875\u9762\u89c6\u89c9/\u6d4f\u89c8\u5668\u9a8c\u8bc1/\u54c1\u724c\u8bbe\u8ba1/Banner/\u56fe\u6807/\u793e\u5a92\u56fe/\u8fdb\u5ea6\u6761/\u8f6e\u8be2\u72b6\u6001)\uff1bMySQL\u6570\u636e\u5e93(MySQL/\u6570\u636e\u5e93\u8bbe\u8ba1/SQL/\u7d22\u5f15/\u4e8b\u52a1/\u6162\u67e5\u8be2/EXPLAIN/DDL/\u8fc1\u79fb/\u8868\u7ed3\u6784/SQL\u4f18\u5316)\u3002",
