{
  "changelog": "mu-ippt 1.1.0 \u66f4\u65b0\u65e5\u5fd7\n\n- \u589e\u52a0\u591a\u9875PPT\u9700\u6c42\u7684\u300c\u5de5\u4f5c\u6d410\u300d\u8def\u7531\u8bca\u65ad\uff0c\u89c4\u8303\u5316\u4ece\u96f6\u751f\u6210\u4e0e\u4e13\u4e1a\u6a21\u677f\u7684\u6df7\u5408\u4f7f\u7528\u6d41\u7a0b\u3002\n- \u5f3a\u5316\u8bbe\u8ba1\u54f2\u5b66\u63a8\u8350\u6d41\u7a0b\uff0c\u5fc5\u987b\u7528\u5177\u540d\u54f2\u5b66\u6d41\u6d3e\uff0c\u675c\u7edd\u6a21\u7cca\u98ce\u683c\u8bcd\u8bed\u3002\n- \u65b0\u589e\u9875\u9762\u89c4\u5212\u8868\u786e\u8ba4\u673a\u5236\u53caA/B/C/D\u56db\u65b9\u6848\u9009\u62e9\uff0c\u7528\u6237\u9700\u5148\u786e\u8ba4\u518d\u751f\u4ea7\u5185\u5bb9\u3002\n- \u4e25\u683cBLOCKING\u6b65\u9aa4\u63a7\u5236\uff0cPPTX\u4ea4\u4ed8\u524d\u5fc5\u987b\u901a\u8fc7\u89c6\u89c9\u9a8c\u8bc1\uff0c\u914d\u8272\u7edf\u4e00\u4e0d\u53ef\u8df3\u8fc7\u3002\n- \u4e30\u5bccPPT\u652f\u6301\u573a\u666f\uff0c\u8986\u76d6PPT\u4ece\u96f6\u751f\u6210\u3001\u6280\u672f\u56fe\u8868\u3001\u54a8\u8be2\u6a21\u677f\u4e0e\u5df2\u6709\u5185\u5bb9\u7f16\u8f91\u3002\n- \u4f18\u5316\u5de5\u4f5c\u6d41\u6574\u5408\u4e0e\u914d\u8272\u540e\u5904\u7406\u6d41\u7a0b\uff0c\u63d0\u5347\u6700\u7ec8\u6f14\u793a\u6587\u7a3f\u89c6\u89c9\u4e00\u81f4\u6027\u3002",
